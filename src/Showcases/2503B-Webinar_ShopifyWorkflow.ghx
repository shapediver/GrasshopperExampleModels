            <chunk name="Object" index="81">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">a9a8ebd2-fff5-4c44-a8f5-739736d129ba</item>
                <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="10">
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconDisplay" type_name="gh_int32" type_code="3">2</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">e1cf431d-2dc2-453c-b646-41275538ef05</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">changeCurveEnds</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">    //if nothing was provided, return the original curve
    if(pntStart == null &amp;&amp; vecStart == null &amp;&amp; pntEnd == null &amp;&amp; vecEnd == null){
      A = crv;
      return;
    }

    //convert curve into nurbs curve to be able to edit the ends
    NurbsCurve crvNurbs = (NurbsCurve) crv;

    //check if we need to change anything in the start of the curve
    if(pntStart != null || vecStart != null){

      //check which data was provided. If data is not provided, use the original data from curve
      Point3d _pntStart = pntStart == null ? crv.PointAtStart : (Point3d) pntStart;
      Vector3d _vecStart = vecStart == null ? crv.TangentAtStart : (Vector3d) vecStart;
      _vecStart.Unitize();

      //change start of curve
      crvNurbs.SetEndCondition(false, NurbsCurve.NurbsCurveEndConditionType.Tangency, _pntStart, _vecStart);
    }

    //check if we need to change anything in the end of the curve
    if(pntEnd != null || vecEnd != null){

      //check which data was provided. If data is not provided, use the original data from curve
      Point3d _pntEnd = pntEnd == null ? crv.PointAtEnd : (Point3d) pntEnd;
      Vector3d _vecEnd = vecEnd == null ? crv.TangentAtEnd : (Vector3d) vecEnd;
      _vecEnd.Unitize();

      //change end of curve
      crvNurbs.SetEndCondition(true, NurbsCurve.NurbsCurveEndConditionType.Tangency, _pntEnd, _vecEnd);
    }

    A = crvNurbs;</item>
                  </items>

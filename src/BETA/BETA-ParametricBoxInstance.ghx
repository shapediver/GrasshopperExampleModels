                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">2</item>
                        <item name="Description" type_name="gh_string" type_code="10">All of the geometry coming in here will be converted to meshes, polylines, or points and included in a single glTF asset to be displayed in ShapeDiver's Viewer.</item>

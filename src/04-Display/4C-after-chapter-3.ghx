                    <chunk name="param_input" index="3">
                      <items count="7">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">Optional curves used to create holes in the output mesh. If hole boundaries are the only input then the result may be null if Trimback is set to false (see comments for trimback) because the resulting mesh could be invalid.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">bda062ca-8677-44a4-82a0-069389c49829</item>
                        <item name="Name" type_name="gh_string" type_code="10">Hole  Boundaries</item>

                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">142a2a8c-4020-4440-b4dc-053e77bf2412</item>
                    <item name="Name" type_name="gh_string" type_code="10">Panel</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Define geometry outputs</item>

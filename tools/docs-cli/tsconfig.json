{
    "compilerOptions": {
        "lib": [
            "ES2024"
        ],
        "types": [
            "node"
        ],
        "module": "nodenext",
        "target": "ES2024",
        "moduleResolution": "nodenext",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "./src/**/*.ts"
    ]
}
